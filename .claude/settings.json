{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" pull --rebase --autostash 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Syncing vault from git..."
          }
        ]
      }
    ]
  }
}
